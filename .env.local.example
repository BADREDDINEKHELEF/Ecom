# ============================================================
# ShopDZ — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. Server-only. NEVER expose to client.
# Found in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin Auth (required) ────────────────────────────────────
# Minimum 32 bytes. Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# Optional: comma-separated IPs allowed to access /admin
# Leave empty to allow all IPs (not recommended for production)
ADMIN_IP_ALLOWLIST=

# Optional: TOTP/2FA secret. Generate via /api/admin/totp (one-time endpoint)
ADMIN_TOTP_SECRET=

# ── Field Encryption (required for vendor credential storage) ─
# Generate: openssl rand -hex 32  (must be exactly 64 hex chars)
FIELD_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ── Delivery APIs ────────────────────────────────────────────
YALIDINE_API_ID=your-yalidine-api-id
YALIDINE_API_TOKEN=your-yalidine-api-token

# ── Resend (transactional email) ────────────────────────────
# Get at: https://resend.com → API Keys
# Enables order confirmation, shipping update, and abandoned cart emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp Business API (optional) ────────────────────────
# From: Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Payment Gateways (optional) ─────────────────────────────
# Satim (CIB / Edahabia) — leave blank if not using online payment
# USERNAME is usually merchant_id:terminal_id (or just merchant_id)
SATIM_USERNAME=
SATIM_PASSWORD=
SATIM_BASE_URL=https://satim.dz

# BaridiMob — leave blank if not using BaridiMob
BARIDIMOB_MERCHANT_ID=
BARIDIMOB_API_KEY=

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=ShopDZ

# Full URL of your deployment (no trailing slash)
# Vercel sets this automatically; set manually for other hosts
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Number of trusted reverse proxies in front of this app.
# Set to 1 if running behind a single nginx/load balancer.
# Leave at 0 for Vercel (uses x-real-ip instead).
TRUSTED_PROXY_COUNT=0

# ── Rate Limiting (optional — for production scalability) ────
# Install: npm i @upstash/ratelimit @upstash/redis
# Then follow UPGRADE.md to switch from in-memory to Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Sentry Error Tracking (optional but strongly recommended for production) ─
# Create a project at sentry.io, then:
# 1. Add NEXT_PUBLIC_SENTRY_DSN (browser + server errors)
# 2. Add SENTRY_AUTH_TOKEN for source map uploads during `next build`
#    Generate at: Sentry → Settings → Auth Tokens → Create New Token (scope: project:releases)
# 3. Add SENTRY_ORG (your Sentry organisation slug)
# 4. Add SENTRY_PROJECT (your Sentry project slug)
# Leave all empty to disable Sentry entirely (no errors, no warnings).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Analytics & Pixels (optional — leave blank to disable) ──────────────────
# Meta Pixel: get your Pixel ID from business.facebook.com > Events Manager
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# Meta Conversions API token (server-side) — from Meta Events Manager > Settings
# Required for reliable Purchase tracking (not blocked by ad blockers)
# META_CAPI_TOKEN=EAAMxxxxxxxxxxxxxxx

# Google Analytics / Ads (optional)
# NEXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX
# GA4 Measurement Protocol API secret — from GA4 Admin > Data Streams > Measurement Protocol
# GTAG_API_SECRET=xxxxxxxxxxxxxxxx

# TikTok Pixel (optional)
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXX
# TikTok Events API token (server-side) — from TikTok Events Manager
# TIKTOK_CAPI_TOKEN=xxxxxxxxxxxxxxxx
