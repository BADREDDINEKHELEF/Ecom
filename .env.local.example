# ============================================================
# ShopDZ — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. Server-only. NEVER expose to client.
# Found in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin Auth (required) ────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 32
ADMIN_SECRET=change-this-to-a-strong-password

# Minimum 32 bytes. Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# Optional: comma-separated IPs allowed to access /admin
# Leave empty to allow all IPs (not recommended for production)
ADMIN_IP_ALLOWLIST=

# Optional: TOTP/2FA secret. Generate via /api/admin/totp (one-time endpoint)
ADMIN_TOTP_SECRET=

# ── Field Encryption (required for vendor credential storage) ─
# Generate: openssl rand -hex 32  (must be exactly 64 hex chars)
FIELD_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ── Delivery APIs ────────────────────────────────────────────
YALIDINE_API_ID=your-yalidine-api-id
YALIDINE_API_TOKEN=your-yalidine-api-token

# ── WhatsApp Business API (optional) ────────────────────────
# From: Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=ShopDZ

# Number of trusted reverse proxies in front of this app.
# Set to 1 if running behind a single nginx/load balancer.
# Leave at 0 for Vercel (uses x-real-ip instead).
TRUSTED_PROXY_COUNT=0

# ── Rate Limiting (optional — for production scalability) ────
# Install: npm i @upstash/ratelimit @upstash/redis
# Then follow UPGRADE.md to switch from in-memory to Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
